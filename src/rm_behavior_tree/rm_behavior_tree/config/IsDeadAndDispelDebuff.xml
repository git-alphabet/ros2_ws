<root BTCPP_format="4">
    <BehaviorTree ID="IsDeadAndDispelDebuff">
        <Sequence>

            <!-- A. 战亡：只停车等待复活读条结束 -->
            <Sequence name="IfDead_StopAndWait">
                <IsDead message="{robot_status}"/>
                <RobotControl stop_gimbal_scan="True" 
                              chassis_spin="False"/>
                <NavControlCmd cmd_type="3" 
                               emergency_stop="False"/>
            </Sequence>

            <!-- B. 恢复模式：复活后强制回补给区刷卡解除虚弱并回血 -->
            <Sequence name="RecoveryMode">

                <!-- 检测复活沿：dead -> alive 时置 need_recovery=true -->
                <DetectRespawnAndSetRecovery
                    topic_name="/robot_status"
                    was_dead="{was_dead}"
                    hp_cur="{hp_cur}"
                    need_recovery="{need_recovery}"
                    recovery_start_ms="{recovery_start_ms}"
                    search_start_ms="{search_start_ms}"
                    heal_start_ms="{heal_start_ms}"/>

                <IsRecoveryNeeded need_recovery="{need_recovery}"/>

                <Fallback name="RecoveryFlow">

                    <!-- 成功分支：检测到补给区RFID -> 等待回血 -> 清除恢复flag -->
                    <Sequence name="IfSupplyCard_Heal_Exit">
                        <IsSupplyCardDetected rfid_status="{rfid.status}"/>

                        <!-- 等待回血到指定比例 -->
                        <WaitAndHeal
                            topic_name="/robot_status"
                            now_ms="{now_ms}"
                            heal_start_ms="{heal_start_ms}"
                            heal_wait_ms="{cfg.heal_wait_ms}"
                            hp_cur="{hp_cur}"
                            hp_max="{hp_max}"
                            heal_min_ratio="{cfg.heal_min_ratio}"/>

                        <!-- 退出恢复模式 -->
                        <ClearRecoveryFlag
                            need_recovery="{need_recovery}"
                            heal_start_ms="{heal_start_ms}"
                            search_start_ms="{search_start_ms}"
                            recovery_start_ms="{recovery_start_ms}"/>
                    </Sequence>

                    <!-- 失败分支：未检测到卡 -> 去补给区 -> 到达后微搜 -->
                    <Sequence name="GoSupply_ThenSearch">

                        <!-- 1. 启动导航模式（确保导航器处于可接收目标的状态） -->
                        <NavControlCmd cmd_type="1" emergency_stop="False"/>

                        <!-- 2. 导航到补给区（到达前持续RUNNING,不会导致Sequence失败） -->
                        <ReactiveFallback name="NavUntilArrived">
                            <!-- 分支A: 已到达 -> 返回SUCCESS,跳过导航 -->
                            <IsAtNavGoal rfid_status="{rfid.status}"/>

                            <!-- 分支B: 未到达 -> 持续发布导航目标并返回RUNNING -->
                            <ReactiveSequence>
                                <RateController hz="5">
                                    <SendGoal name="GoSupplyToHeal"
                                        goal_x="{cfg.supply_goal_x}"
                                        goal_y="{cfg.supply_goal_y}"
                                        frame_id="map"
                                        action_name="navigate_to_pose"/>
                                </RateController>
                                <KeepRunning/>
                            </ReactiveSequence>
                        </ReactiveFallback>

                        <!-- 3. 到达后先刹车并切换到原地不动模式（为微搜做准备） -->
                        <RobotControl stop_gimbal_scan="True" 
                                      chassis_spin="False"/>
                        <NavControlCmd cmd_type="3" 
                                       emergency_stop="False"/>

                        <!-- 4. 初始化搜卡计时器（开始计时） -->
                        <InitSearchTimerIfNeeded search_start_ms="{search_start_ms}"/>

                        <!-- 5. 先尝试直接感应补给卡，感应不到再执行微动搜索 -->
                        <ReactiveFallback name="DetectOrMicroSearch">
                            <!-- 优先检测：如果直接感应到补给卡，立即返回SUCCESS -->
                            <IsSupplyCardDetected rfid_status="{rfid.status}"/>

                            <!-- 备选方案：执行微动搜索，持续RUNNING直到刷到卡或超时 -->
                            <MicroSearchSupplyCard
                                search_start_ms="{search_start_ms}"
                                timeout_ms="{cfg.search_timeout_ms}"
                                rfid_status="{rfid.status}"
                                rfid_supply_arrived="{rfid.supply_arrived}"/>
                        </ReactiveFallback>

                    </Sequence>

                </Fallback>

            </Sequence>

        </Sequence>
    </BehaviorTree>

</root>