<root BTCPP_format="4">
  <BehaviorTree ID="HighHPCombatLogic">
    <ReactiveSequence>
      <IsHPAbove message="{robot_status}" hp_threshold="300"/>

      <!-- 高血：被打闪避；不被打就站着 -->
      <Fallback>

        <ReactiveSequence>
          <!-- 待定控制区坐�?-->
          <IsAttacked message="{robot_status}"/>
          <GetCurrentLocation current_location="{current_location}"/>
          <MoveAround expected_nearby_goal_count="5"
                      expected_dis="0.35"
                      message="{current_location}"/>
        </ReactiveSequence>

        <!-- 没被打：站着不动（保持云台扫描可选） -->
        <!-- FIX: 原来 RobotControl 和 NavControlCmd 作为 Fallback 的独立子节点，
             RobotControl 返回 SUCCESS 导致 NavControlCmd 永远不执行。
             现在包裹在 Sequence 中，确保两者都执行 -->
        <Sequence>
          <RobotControl stop_gimbal_scan="False"
            chassis_spin="True"/>
          <NavControlCmd cmd_type="3" emergency_stop="False"/>
        </Sequence>

      </Fallback>

    </ReactiveSequence>
  </BehaviorTree>
</root>